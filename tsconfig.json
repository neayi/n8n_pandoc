{
  "compilerOptions": {
    "target": "ES2019",
    "module": "Node16",
    "lib": ["ES2019"],
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["nodes/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
